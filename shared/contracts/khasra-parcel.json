{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KhasraParcelSchema",
  "type": "object",
  "required": ["khasra_id", "ward", "owner_name", "slope_deg", "factor_of_safety", "risk_tier"],
  "properties": {
    "khasra_id": { "type": "string" },
    "ward": { "type": "string" },
    "owner_name": { "type": "string" },
    "family_count": { "type": "integer" },
    "slope_deg": { "type": "number" },
    "structure_type": { "type": "string" },
    "factor_of_safety": { "type": "number" },
    "risk_tier": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH"] },
    "safe_shelter": { "type": "string" }
  }
}
