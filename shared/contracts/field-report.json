{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FieldCrackReportSchema",
  "type": "object",
  "required": ["report_id", "latitude", "longitude", "hazard_type", "confidence", "is_offline_cached"],
  "properties": {
    "report_id": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "hazard_type": { "type": "string" },
    "confidence": { "type": "number" },
    "image_url_or_hash": { "type": "string" },
    "is_offline_cached": { "type": "boolean" },
    "timestamp_iso": { "type": "string" }
  }
}
