# Machine Learning & Large Files
# Ignore large model artifacts
ml/models/**/*.h5
ml/models/**/*.pt
ml/models/**/*.pth
ml/models/**/*.pkl
ml/models/**/*.joblib
ml/models/**/*.bin
!ml/models/**/.gitkeep

# Ignore raw datasets
geospatial/data/dem/*.tif
geospatial/data/dem/*.tiff
geospatial/data/landcover/*.tif
geospatial/data/boundaries/*.shp
geospatial/data/boundaries/*.shx
geospatial/data/boundaries/*.dbf
geospatial/data/boundaries/*.prj
ml/data/raw/*
!ml/data/raw/.gitkeep
!geospatial/data/dem/.gitkeep
!geospatial/data/landcover/.gitkeep
!geospatial/data/boundaries/.gitkeep

# Ensure required sample data is tracked
!ml/data/sample/
!geospatial/data/roads/
!geospatial/data/hospitals/
!geospatial/data/shelters/
!geospatial/data/villages/

